local function getRealUnixTime()
    local urls = {"https://worldtimeapi.org/api/timezone/America/El_Salvador","https://timeapi.io/api/Time/current/zone?timeZone=America/El_Salvador"}
    for _, url in ipairs(urls) do
        local ok, r = pcall(function() return game:HttpGet(url) end)
        if ok and r and r ~= "" then
            local u = r:match('"unixtime"%s*:%s*(%d+)') or r:match('"timestamp"%s*:%s*"([^"]+)"')
            if u then return tonumber(u) end
        end
    end
