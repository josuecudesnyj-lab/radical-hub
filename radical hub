        if key == "" then
            statusLabel.Text = "Ingresa una key"
            statusLabel.TextColor3 = KEY_CONFIG.Theme.Error
            return
        end
        key = string.upper(key)
        key = string.gsub(key, "%s+", " ")
        key = string.gsub(key, "^%s*(.-)%s*$", "%1")

        if key == KEY_CONFIG.ADMIN_KEY then
            if IS_ADMIN then
