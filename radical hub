local function getEndOfMonthTimestamp()
    local now = os.time()
    local year = tonumber(os.date("%Y", now))
    local month = tonumber(os.date("%m", now))
    local day = tonumber(os.date("%d", now))

    if day >= 30 then
        month = month + 1
        if month > 12 then
            month = 1
            year = year + 1
        end
    end

    local endTime = os.time({
        year = year,
        month = month,
        day = 30,
        hour = 23,
        min = 59,
        sec = 59,
    })
    return endTime
end

local function saveLicense(hubType, hoursAdded)
    local now = getCurrentTime()
    local expiresAt

    if hoursAdded == "END_OF_MONTH" then
        expiresAt = getEndOfMonthTimestamp()
    else
        expiresAt = now + (hoursAdded * 3600)
    end

    local data = {
        HubType = hubType,
        ActivatedAt = now,
        ExpiresAt = expiresAt,
        UserId = player.UserId,
        UserName = player.Name
    }
    if _writefile then pcall(function() _writefile(KEY_CONFIG.SaveFile, HttpService:JSONEncode(data)) end) end
    CURRENT_LICENSE = data
end

local function loadLicense()
    if not (_isfile and _readfile) then return nil end
    local exists = false
    pcall(function() exists = _isfile(KEY_CONFIG.SaveFile) end)
    if not exists then return nil end
    local raw
    pcall(function() raw = _readfile(KEY_CONFIG.SaveFile) end)
    if not raw or raw == "" then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or not data then return nil end
    if data.UserId ~= player.UserId then return nil end
    return data
end

local function isLicenseValid(data)
    if not data or not data.ExpiresAt then return false end
    return getCurrentTime() < data.ExpiresAt
end

local function getRemainingTime(data)
    if not data or not data.ExpiresAt then return 0 end
    return math.max(0, data.ExpiresAt - getCurrentTime())
end

local function formatRemaining(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    return hours .. "h " .. mins .. "m"
end

local function formatRemainingShort(seconds)
    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    if days > 0 then
        return days .. "d " .. hours .. "h"
    end
    local mins = math.floor((seconds % 3600) / 60)
    return hours .. "h " .. mins .. "m"
end

