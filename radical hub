local function callGeminiAPI(userMessage, callback)
    task.spawn(function()
        local http = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
        if not http then callback(false, "No hay soporte HTTP.") return end

        local url = "https://generativelanguage.googleapis.com/v1beta/models/" .. KEY_CONFIG.GEMINI_MODEL .. ":generateContent?key=" .. KEY_CONFIG.GEMINI_API_KEY

        local body = {
            contents = {
                { parts = { { text = AI_SYSTEM_PROMPT .. "\n\nUsuario: " .. userMessage } } }
            },
            generationConfig = { temperature = 0.7, maxOutputTokens = 500 }
        }

        local success, response = pcall(function()
            return http({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(body)
            })
        end)

        if not success or not response then callback(false, "Error de conexion.") return end
        if response.StatusCode ~= 200 then callback(false, "Error del servidor (" .. tostring(response.StatusCode) .. ")") return end

        local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if not ok or not decoded then callback(false, "Error al procesar respuesta.") return end

        if decoded.candidates and decoded.candidates[1] and decoded.candidates[1].content and decoded.candidates[1].content.parts and decoded.candidates[1].content.parts[1] then
            local text = decoded.candidates[1].content.parts[1].text
            text = string.gsub(text, "%*%*", "")
            text = string.gsub(text, "%*", "")
            text = string.gsub(text, "`", "")
            text = string.gsub(text, "#", "")
            text = string.gsub(text, "^%s+", "")
            callback(true, text)
        else
            callback(false, "La IA no pudo responder.")
        end
    end)
end

