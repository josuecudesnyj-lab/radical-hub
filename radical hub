local function startHub(hubType)
    print("RADICAL HUB cargado - Hub: " .. hubType)
    task.wait(0.5)
    loadUI()
end

if IS_ADMIN then
    print("Admin detectado. Ingresa tu key ADMIN ROOT.")
    showKeyScreen(startHub)
else
    local savedLicense = loadLicense()
    if savedLicense and isLicenseValid(savedLicense) then
        CURRENT_LICENSE = savedLicense
        USING_ADMIN_KEY = false
        print("Licencia valida (" .. savedLicense.HubType .. "). Expira en: " .. formatRemaining(getRemainingTime(savedLicense)))
        startHub(savedLicense.HubType)
    else
        if savedLicense then
            print("Licencia expirada. Pide una nueva.")
        else
            print("Sin licencia. Pide una key.")
        end
        showKeyScreen(startHub)
    end
end

print("RADICAL HUB - Cargado")
