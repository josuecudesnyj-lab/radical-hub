local function fetchCountryFlag(callback)
    if COUNTRY_FLAG_URL then
        callback(COUNTRY_FLAG_URL)
        return
    end
    task.spawn(function()
        local http = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
        if not http then callback(nil) return end

        local code = nil

        -- Intento 1: ipwho.is
        local ok1, res1 = pcall(function()
            return http({ Url = "https://ipwho.is/", Method = "GET" })
        end)
        if ok1 and res1 and res1.StatusCode == 200 then
            local okd, d = pcall(function() return HttpService:JSONDecode(res1.Body) end)
            if okd and d and d.country_code then code = d.country_code end
        end

        -- Intento 2: ipapi.co
        if not code then
            local ok2, res2 = pcall(function()
                return http({ Url = "https://ipapi.co/json/", Method = "GET" })
            end)
            if ok2 and res2 and res2.StatusCode == 200 then
                local okd, d = pcall(function() return HttpService:JSONDecode(res2.Body) end)
                if okd and d and d.country_code then code = d.country_code end
            end
        end

        -- Intento 3: ip-api.com
        if not code then
            local ok3, res3 = pcall(function()
                return http({ Url = "http://ip-api.com/json/", Method = "GET" })
            end)
            if ok3 and res3 and res3.StatusCode == 200 then
                local okd, d = pcall(function() return HttpService:JSONDecode(res3.Body) end)
                if okd and d and d.countryCode then code = d.countryCode end
            end
        end

        if not code then
            callback(nil)
            return
        end

        code = string.lower(code)
        COUNTRY_CODE = string.upper(code)
        COUNTRY_FLAG_URL = "https://flagcdn.com/w80/" .. code .. ".png"
        callback(COUNTRY_FLAG_URL)
    end)
end

