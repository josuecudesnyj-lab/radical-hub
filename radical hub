    auraTitle.Size = UDim2.new(1, 0, 0, 20)
    auraTitle.Position = UDim2.new(0, 0, 0, 70)
    auraTitle.BackgroundTransparency = 1
    auraTitle.Text = "AURAS VFX"
    auraTitle.TextColor3 = Color3.fromRGB(150, 0, 255)
    auraTitle.Font = Enum.Font.GothamBold
    auraTitle.TextSize = 10
    auraTitle.TextXAlignment = Enum.TextXAlignment.Center
    auraTitle.ZIndex = 3
    local auraConfig = {
        {name = "Inferno", color = Color3.fromRGB(255, 80, 0)},
        {name = "Electric", color = Color3.fromRGB(0, 170, 255)},
        {name = "DarkSpirit", color = Color3.fromRGB(150, 0, 255)},
        {name = "Toxic", color = Color3.fromRGB(0, 255, 80)},
        {name = "Frost", color = Color3.fromRGB(200, 230, 255)},
    }
    for idx, aura in ipairs(auraConfig) do
        local row = math.floor((idx - 1) / 2)
        local col = (idx - 1) % 2
        local btn = Instance.new("TextButton", appScroll)
        btn.Size = UDim2.new(0.48, 0, 0, 26)
        btn.Position = UDim2.new(0.01 + (col * 0.5), 0, 0, 100 + (row * 32))
        btn.BackgroundColor3 = aura.color
        btn.BackgroundTransparency = 0.75
        btn.Text = aura.name
        btn.TextColor3 = aura.color
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 9
        btn.ZIndex = 3
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(function()
            if activeAura == aura.name then
                activeAura = nil
                for _, obj in pairs(auraObjects) do if obj and obj.Parent then obj:Destroy() end end
                auraObjects = {}
                btn.BackgroundTransparency = 0.75
            else
                activeAura = aura.name
                for _, obj in pairs(auraObjects) do if obj and obj.Parent then obj:Destroy() end end
                auraObjects = {}
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local emitter = Instance.new("ParticleEmitter")
                    emitter.Texture = "rbxassetid://243098098"
                    emitter.Color = ColorSequence.new(aura.color, aura.color)
                    emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.5, 2), NumberSequenceKeypoint.new(1, 0)})
                    emitter.Rate = 100
                    emitter.Speed = NumberRange.new(2, 5)
                    emitter.Lifetime = NumberRange.new(0.5, 1.5)
                    emitter.SpreadAngle = Vector2.new(30, 30)
                    emitter.Parent = hrp
                    table.insert(auraObjects, emitter)
                end
                btn.BackgroundTransparency = 0.3
            end
        end)
    end
end

