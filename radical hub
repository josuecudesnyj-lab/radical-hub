-- ============================================================
local FLY_STATE = {
    active = false,
    speed = 1,
    maxSpeed = 50,
    connection = nil,
}

local function stopFly()
    FLY_STATE.active = false
    if FLY_STATE.connection then
        pcall(function() FLY_STATE.connection:Disconnect() end)
        FLY_STATE.connection = nil
    end
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        if char:FindFirstChild("Animate") then
            char.Animate.Disabled = false
        end
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BodyVelocity") and v.Name == "RADICAL_FlyBV" then v:Destroy() end
            if v:IsA("BodyGyro") and v.Name == "RADICAL_FlyBG" then v:Destroy() end
        end
    end
end

local function startFly()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    FLY_STATE.active = true

    local part
    if hum.RigType == Enum.HumanoidRigType.R6 then
        part = char:FindFirstChild("Torso")
    else
        part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    end
    if not part then part = char:FindFirstChild("HumanoidRootPart") end
    if not part then return end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "RADICAL_FlyBV"
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = part

    local bg = Instance.new("BodyGyro")
    bg.Name = "RADICAL_FlyBG"
    bg.P = 9e4
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = part.CFrame
    bg.Parent = part

    local running = true
    FLY_STATE.connection = RunService.Heartbeat:Connect(function()
        if not running or not FLY_STATE.active then return end
        if not char or not char.Parent then running = false; return end
        if not part or not part.Parent then running = false; return end

        local spd = FLY_STATE.speed
        local moveDir = hum.MoveDirection

        if moveDir.Magnitude > 0 then
            bv.Velocity = Vector3.new(moveDir.X * spd * 15, 0, moveDir.Z * spd * 15)
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
    end)

    hum.Died:Connect(function() stopFly() end)
    char.AncestryChanged:Connect(function()
        if not char.Parent then stopFly() end
    end)
end

